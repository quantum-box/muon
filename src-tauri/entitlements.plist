<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        Minimal hardened-runtime entitlements for the Muon Tauri desktop app.
        Tauri/WebView apps need JIT + unsigned executable memory exceptions
        because WebKit JIT-compiles JavaScript at runtime.
        disable-library-validation is required when loading non-Apple-signed
        dynamic libraries shipped in the bundle (e.g. Tauri plugin dylibs).
    -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
